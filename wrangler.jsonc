{
  // FeedbackBee: self-hostable feedback widget on the Cloudflare free tier.
  // database_id pins this deployment's D1 database. For another account, run:
  //   pnpm exec wrangler d1 create feedbackbee
  // and replace database_id below with the new database's id.
  "name": "feedbackbee",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "feedbackbee", "database_id": "c415d47c-ece2-44ee-b296-1408b96b92ee", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "feedbackbee-media" }
  ],
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/embed.js", "/embed-capture.js", "/embed-record.js", "/replay-player.js", "/replay/*", "/f/*", "/demo"]
  },
  "vars": {
    "MEDIA_BASE": ""
  },
  "workers_dev": true
}
