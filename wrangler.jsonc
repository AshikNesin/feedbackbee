{
  // FeedbackBarn — self-hostable feedback widget on the Cloudflare free tier.
  // Run once per account, then paste the database id:
  //   npx wrangler d1 create feedbackbarn
  //   npx wrangler r2 bucket create feedbackbarn-media
  "name": "feedbackbarn",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "feedbackbarn", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "feedbackbarn-media" }
  ],
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/embed.js", "/f/*"]
  },
  "vars": {
    "MEDIA_BASE": ""
  },
  "workers_dev": true
}
