{
  // FeedbackBee — self-hostable feedback widget on the Cloudflare free tier.
  // database_id is intentionally omitted so the Deploy to Cloudflare button
  // auto-provisions D1 and R2 in the target account. For manual deploys run:
  //   pnpm exec wrangler d1 create feedbackbee   (paste the id below to pin it)
  "name": "feedbackbee",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "feedbackbee", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "feedbackbee-media" }
  ],
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/embed.js", "/f/*", "/demo"]
  },
  "vars": {
    "MEDIA_BASE": ""
  },
  "workers_dev": true
}
