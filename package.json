{
  "name": "feedbackbee",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable feedback widget that files GitHub issues, on the Cloudflare free tier",
  "keywords": [],
  "homepage": "https://github.com/AshikNesin/feedbackbee#readme",
  "bugs": {
    "url": "https://github.com/AshikNesin/feedbackbee/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshikNesin/feedbackbee.git"
  },
  "type": "module",
  "main": "dist/server/bundle.js",
  "scripts": {
    "dev": "NODE_ENV=development PORTLESS_PORT=8888 portless run --name $npm_package_name tsx scripts/dev.ts",
    "build": "rm -rf dist && vp build && node scripts/build.mjs",
    "start": "NODE_ENV=production node dist/server/bundle.js",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:tokens": "tsx scripts/check-design-tokens.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/server.tsbuildinfo && tsc --noEmit -p apps/web --incremental --tsBuildInfoFile node_modules/.cache/tsc/client.tsbuildinfo && tsc --noEmit -p tests/e2e --incremental --tsBuildInfoFile node_modules/.cache/tsc/e2e.tsbuildinfo && pnpm run --if-present typecheck:app",
    "typecheck:client": "tsc --noEmit -p apps/web",
    "typecheck:kit": "tsc --noEmit -p tests/kit-consumers",
    "typecheck:app": "tsc --noEmit -p tests/worker",
    "check:closure": "node scripts/check-runtime-closure.mjs",
    "check:coverage": "tsx scripts/check-checks-coverage.ts",
    "test": "NODE_ENV=test vp test run --config vitest.config.server.ts",
    "test:client": "vp test run",
    "test:all": "pnpm test && pnpm test:client && pnpm test:worker",
    "test:watch": "NODE_ENV=test vp test --config vitest.config.server.ts",
    "test:e2e": "PORTLESS=0 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prepare": "node scripts/relative-hooks-path.mjs; vp config || [ ! -x node_modules/.bin/vp ]",
    "groot:setup": "bash .groot/setup-boilerplate.sh",
    "groot:check": "tsx .groot/sync.ts check",
    "groot:sync": "tsx .groot/sync.ts apply",
    "groot:resolve": "tsx .groot/resolve.ts",
    "groot:upstream": "tsx .groot/upstream.ts",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "doctor": "pnpm dlx react-doctor@latest",
    "dev:worker": "pnpm build:client && wrangler dev",
    "build:client": "vp build && node site/build.mjs",
    "deploy:worker": "pnpm build:client && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir tmp/worker-build",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate:worker": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "test:worker": "vitest run --config vitest.config.worker.ts",
    "build:embed": "python3 apps/web/scripts/build-embed.py",
    "build:cf": "pnpm build:client",
    "deploy": "pnpm deploy:worker",
    "build:site": "node site/build.mjs",
    "check:pnpm-policy": "tsx scripts/check-pnpm-policy.ts",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e",
    "check:dead": "knip --no-progress || { echo 'Dead code. If a flagged file is loaded by URL, dynamic import or a script, add it to `entry` in knip.json. Otherwise delete it: `pnpm exec tsx scripts/codemods/remove-dead-code.ts` (add --remove-files to delete unused files).'; exit 1; }",
    "check:doc-refs": "node scripts/check-doc-refs.mjs",
    "check:migrations-immutable": "node scripts/check-migrations-immutable.mjs",
    "verify": "pnpm verify:static && pnpm test && pnpm test:client",
    "verify:static": "node scripts/gates.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@hookform/resolvers": "^7.0.3",
    "@sentry/cloudflare": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.5",
    "@uiw/react-codemirror": "^4.25.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "console-feed": "^3.8.0",
    "croner": "^11.0.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "ms": "2.1.3",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@msw/cloudflare": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@rrweb/record": "2.1.7",
    "@sentry/esbuild-plugin": "^11.9.0",
    "@sentry/vite-plugin": "^11.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/micromatch": "4.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.32",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "micromatch": "^4.0.8",
    "modern-screenshot": "4.7.0",
    "motion": "^14.10.1",
    "msw": "^3.0.3",
    "postcss": "^8.5.31",
    "rrweb-player": "2.1.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
