{
  "name": "feedbackbee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy": "pnpm run build:web && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "pnpm --dir web run dev",
    "build:web": "pnpm --dir web run build",
    "build:cf": "pnpm install --frozen-lockfile && pnpm --dir web install --frozen-lockfile && pnpm run build:web",
    "build": "pnpm run build:cf"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@msw/cloudflare": "^0.2.0",
    "msw": "^3.0.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
