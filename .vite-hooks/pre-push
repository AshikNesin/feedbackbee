command -v vp >/dev/null || { echo "vp not found: this worktree has no node_modules. Run pnpm install here, then push again."; exit 1; }

# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# A deletion has an all-zero local sha.
while read -r local_ref local_sha _; do
  case "$local_ref" in refs/tags/*) continue ;; esac
  case "$local_sha" in *[!0]*) exec pnpm typecheck ;; esac
done
