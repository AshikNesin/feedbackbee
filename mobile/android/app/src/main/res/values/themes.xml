<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the first Compose frame (paper), so launch never flashes. -->
    <style name="Theme.FeedbackBee" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
